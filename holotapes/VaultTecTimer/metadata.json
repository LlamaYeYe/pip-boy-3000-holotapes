{
  "id": "vaulttimer",
  "name": "Vault-Tec Timer",
  "author": "@trekker87 @Theeohn",
  "version": "2.0.1",
  "description": "A countdown timer with customizable alerts, and a stopwatch with lap function.",
  "icon": "storage/VAULTTECTIMER.IMG",
  "previews": [
    "previews/MENU.BMP",
    "previews/TIMER.BMP",
    "previews/STOPWATCH.BMP"
  ],
  "type": "app",
  "readme": "README.md",
  "storage": [
    {
      "pipboy": "HOLO/VAULT_TEC_TIMER/APP.JS",
      "source": "storage/APP.TS"
    },
    {
      "pipboy": "HOLO/VAULT_TEC_TIMER/STOPWATCH.JS",
      "source": "storage/STOPWATCH.TS"
    },
    {
      "pipboy": "HOLO/VAULT_TEC_TIMER/TIMER.JS",
      "source": "storage/TIMER.TS"
    },
    {
      "pipboy": "HOLO/VAULT_TEC_TIMER/TITLE.JS",
      "source": "storage/TITLE.TS"
    },
    {
      "pipboy": "HOLO/VAULT_TEC_TIMER/TITLE.BIN",
      "source": "storage/TITLE.BIN"
    }
  ],
  "storageOptional": []
}
