{
  "id": "charswitcher",
  "name": "CND Character Switcher",
  "author": "@Aidan'sLab",
  "version": "1.0.2",
  "description": "A character switching utility for the Pip-Boy 3000.",
  "icon": "storage/CHARSWITCHER.PNG",
  "previews": ["previews/HOLOTAPE.BMP", "previews/CND.BMP"],
  "type": "app",
  "readme": "README.md",
  "storage": [
    {
      "pipboy": "HOLO/CHARSWITCHER/APP.JS",
      "source": "storage/APP.TS"
    },
    {
      "pipboy": "HOLO/CHARSWITCHER/RENDERER.JS",
      "source": "storage/RENDERER.TS"
    },
    {
      "pipboy": "HOLO/CHARSWITCHER/chars/MK_V_VAULT-BOY.JSON",
      "source": "storage/MK_V_VAULT-BOY.JSON"
    },
    {
      "pipboy": "HOLO/CHARSWITCHER/chars/MK_V_VAULT-BOY.BIN",
      "source": "storage/MK_V_VAULT-BOY.BIN"
    },
    {
      "pipboy": "HOLO/CHARSWITCHER/chars/VAULT-GIRL.JSON",
      "source": "storage/VAULT-GIRL.JSON"
    },
    {
      "pipboy": "HOLO/CHARSWITCHER/chars/VAULT-GIRL.BIN",
      "source": "storage/VAULT-GIRL.BIN"
    }
  ],
  "storageOptional": []
}
